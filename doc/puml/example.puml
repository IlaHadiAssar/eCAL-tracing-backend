@startuml eCAL Tracing Data Flow

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 120

participant "eCAL Publisher" as pub
participant "eCAL Subscriber" as sub
participant "Data Collector" as col
participant "Span Mapper" as map
participant "Tracer Provider" as tracer
participant "Jaeger" as jaeger

pub -> sub : publish(topic, data)
note right of pub
  operation=publish
  transport=udp
end note

sub -> sub : receive callback
note right of sub
  operation=receive
  operation=callback
end note

col -> col : discover JSONL files
col -> map : supply span data + metadata

map -> map : decode enums
map -> map : build metadata lookup
map -> map : propagate context\n(publish -> receive -> callback)

map -> tracer : create OTel spans with parent/child links

tracer -> jaeger : export via OTLP HTTP (port 4318)

@enduml
