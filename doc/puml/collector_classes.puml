@startuml Data Collector Classes

skinparam classAttributeIconSize 0
skinparam roundcorner 8

package "main.py" {
    class DataCollector {
        + collect_files(data_dir: str): tuple
        - data_dir: str
    }

    note right of DataCollector
        Discovers ecal_spans_*.jsonl
        and ecal_topic_metadata_*.jsonl
        via glob patterns
    end note
}

package "mapping.py" {
    class FileReader {
        + load_json_file(filepath: str): List[Dict]
    }

    class DataValidator {
        + enrich_spans(spans: List[Dict], metadata_lookup: Dict, id_key: str): None
        + build_metadata_lookup(metadata_list: List[Dict]): Dict
    }
}

DataCollector ..> FileReader : uses
FileReader ..> DataValidator : provides parsed records

@enduml
