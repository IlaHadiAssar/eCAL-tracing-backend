@startuml Span Mapper Classes

skinparam classAttributeIconSize 0
skinparam roundcorner 8

package "mapping.py" {

    class FileLoader {
        + load_json_file(filepath: str): List[Dict]
    }

    class MetadataBuilder {
        + build_metadata_lookup(metadata_list: List[Dict]): Dict[int, Dict]
        + get_tracing_version(metadata_lookup: Dict): str
    }

    class EnumDecoder {
        + decode_layer(layer_value: int): str
        OP_SEND: int = 0
        OP_RECEIVE: int = 1
        OP_CALLBACK: int = 2
        OP_SHM_HANDSHAKE: int = 3
        DIR_PUBLISHER: int = 0
        DIR_SUBSCRIBER: int = 1
    }

    class SpanCreator {
        + create_spans_from_data(all_spans: List[Dict], metadata_lookup: Dict, tracer): None
        - _set_common_attributes(span, data: Dict, op_type_name: str): None
        - set_meta_attributes(span, meta: Dict): None
    }

    class ContextPropagator {
        - publisher_span_contexts: Dict[tuple, SpanContext]
        - receive_span_contexts: Dict[tuple, SpanContext]
        + enrich_spans(spans: List[Dict], metadata_lookup: Dict, id_key: str): None
    }

}

FileLoader ..> MetadataBuilder : provides raw records
FileLoader ..> EnumDecoder : passes op_type / layer values
MetadataBuilder ..> SpanCreator : supplies metadata context
SpanCreator ..> ContextPropagator : registers & resolves parent contexts
ContextPropagator ..> SpanCreator : adds parent/child references

@enduml
