@startuml Tracer & Exporter Classes

skinparam classAttributeIconSize 0
skinparam roundcorner 8

package "exporting.py" {

    class ResourceFactory {
        + create(attributes: Dict): Resource
        --
        service.name = "ecal-tracing"
        service.version = "1.0.0"
        ecal.tracing_version: str
    }

    class TracerFactory {
        + setup_tracer_provider(otlp_endpoint: str, tracing_version: str): tuple
        --
        returns (TracerProvider, Tracer)
    }

    class ConsoleSpanExporter {
        + export(spans: Sequence[Span]): SpanExportResult
        + shutdown(): None
        + force_flush(timeout_millis: int): bool
    }

    class OTLPSpanExporter {
        - endpoint: str
        + export(spans: Sequence[Span]): SpanExportResult
        + shutdown(): None
    }

    class ProcessorManager {
        + add_span_processor(processor: SpanProcessor): None
        --
        SimpleSpanProcessor -> ConsoleSpanExporter
        BatchSpanProcessor  -> OTLPSpanExporter
    }

}

ResourceFactory ..> TracerFactory : configures with Resource
TracerFactory ..> ProcessorManager : registers processors
ProcessorManager --> ConsoleSpanExporter : routes to console (debug)
ProcessorManager --> OTLPSpanExporter : routes to Jaeger via OTLP HTTP

@enduml
